# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here

# Resend (Email)
RESEND_API_KEY=your_resend_api_key

# Notification email for admin alerts
NOTIFICATION_EMAIL=admin@humanityandblessings.com

# Stripe card validation / saved payment method capture
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Site URL (for email templates and OG tags)
NEXT_PUBLIC_SITE_URL=https://www.humanityandblessings.com

# Tawk.to Live Chat
NEXT_PUBLIC_TAWK_PROPERTY_ID=your_tawk_property_id
NEXT_PUBLIC_TAWK_WIDGET_ID=your_tawk_widget_id
